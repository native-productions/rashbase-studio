{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rashbase Studio",
  "version": "0.1.1",
  "identifier": "id.rashgaroth.rashbase-studio",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rashbase Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 7, "y": 29 },
        "acceptFirstMouse": true,
        "transparent": true,
        "windowEffects": {
          "effects": ["underWindowBackground", "mica", "acrylic"],
          "state": "active"
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Native Productions",
    "shortDescription": "Free, AI-native database client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
